{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npx tsc --noEmit -p tsconfig.app.json && npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/downloads/bassh/:path*", "destination": "/bassh", "permanent": false },
    { "source": "/cv/Sam-Green-Solution-Architecture-CV.docx", "destination": "/cv/Sam-Green-Solution-Architecture-CV.pdf", "permanent": false },
    { "source": "/history/:version/cv/Sam-Green-Solution-Architecture-CV.docx", "destination": "/history/:version/cv/Sam-Green-Solution-Architecture-CV.pdf", "permanent": false }
  ],
  "rewrites": [
    { "source": "/kapture", "destination": "/kapture/index.html" },
    { "source": "/kapture/", "destination": "/kapture/index.html" },
    { "source": "/bassh", "destination": "/bassh/index.html" },
    { "source": "/bassh/", "destination": "/bassh/index.html" }
  ]
}
